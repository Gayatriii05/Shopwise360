{
  "rootDirectory": "client",
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://shopwise360-server.onrender.com/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://shopwise360-server.onrender.com/socket.io/$1" }
  ]
}