PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shopwise360
JWT_SECRET=change_this_to_a_long_random_string
ML_SERVICE_URL=http://127.0.0.1:6000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000
REGISTER_RATE_MAX=50
REGISTER_RATE_WINDOW_MS=3600000
# Redis (Phase 4 item 4 — the app fails open to the DB when Redis is unreachable)
REDIS_URL=redis://localhost:6379
DASH_CACHE_TTL=60

# Email notifications (Phase 7 item 1).
# MAIL_TRANSPORT selects the transport:
#   ethereal (default, dev) — free disposable account created on first send,
#     preview URL logged to the console. No sign-up, no cost; the only "send".
#   smtp (production) — set SMTP_HOST/PORT/SECURE/USER/PASS/FROM.
#   json (test/dry-run) — no network; writes the composed message to MAIL_DUMP_DIR.
# MAIL_TRANSPORT=ethereal
# SMTP_HOST=your.smtp.host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_user
# SMTP_PASS=your_password
# SMTP_FROM=ShopWise 360 <no-reply@yourdomain.com>
# MAIL_DUMP_DIR=
